<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPublishable>true</IsPublishable>
    <AssemblyName>Il2CppInspector</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Common/Il2CppInspector.Common/Il2CppInspector.Common.csproj" />
    <ProjectReference Include="../GUI/Il2CppInspector.GUI.csproj" ReferenceOutputAssembly="false" />
    <GamePluginProjects Include="../Plugins/*/*.csproj" />
    <ProjectReference Include="@(GamePluginProjects)" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="PublishGui" AfterTargets="Publish">
    <MSBuild
      Projects="../GUI/Il2CppInspector.GUI.csproj"
      Targets="Publish"
      Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishDir=$(PublishDir);IsPublishable=true;NoBuild=$(NoBuild)"
    />
  </Target>
  <Target Name="PreparePublishBundle" BeforeTargets="PrepareForPublish">
    <PropertyGroup>
      <_PublishArtifactsRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(ArtifactsPath)'))</_PublishArtifactsRoot>
      <_PublishBundleDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(PublishDir)'))</_PublishBundleDirectory>
    </PropertyGroup>
    <!-- Publishing replaces the bundle, including files left by a different configuration or the old project layout. -->
    <RemoveDir
      Directories="$(_PublishBundleDirectory)"
      Condition="$([System.String]::Copy('$(_PublishBundleDirectory)').StartsWith('$(_PublishArtifactsRoot)', System.StringComparison.OrdinalIgnoreCase)) and '$(_PublishBundleDirectory)' != '$(_PublishArtifactsRoot)'"
    />
  </Target>
  <Import Project="../GamePlugins.targets" />
</Project>
